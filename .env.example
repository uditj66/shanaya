# Every variable the app uses. Keep .env.local (your computer) and Vercel → Settings → Environment Variables
# (Production) in step with this list: same names in both places; only the URL values differ.

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI (website chat) ── OPENAI_MODEL must be a model your OpenAI project allows
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# ── Addresses ── (local values / production values)
PUBLIC_APP_URL=http://localhost:3000                  # https://lumiere-facial-studio.vercel.app
# Other addresses (e.g. the *.vercel.app one) redirect here. Leave empty locally.
PRIMARY_SITE_URL=                                     # https://lumiere-facial-studio.vercel.app
# Show placeholder content (labelled "Sample") until real photos, reviews and offers are added; set false then.
SHOW_SAMPLE_CONTENT=true

# ── Vapi (phone and website voice) ──
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_CREDENTIAL_ID=
VAPI_ASSISTANT_ID=

# ── Razorpay ──
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
